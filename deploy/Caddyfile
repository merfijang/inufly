# InuFly on its sslip.io hostname (sslip.io resolves inu-<ip-with-dashes>.sslip.io to that IP,
# so no DNS setup). /ws, /stats and /health go to the node process; /site/* serves the assets the
# Vercel-hosted index.html loads (built with --base=https://<this host>/site/).
inu-195-226-93-13.sslip.io {
	encode gzip
	@api path /ws /stats /health
	handle @api {
		reverse_proxy 127.0.0.1:8788
	}
	handle_path /site/* {
		header Access-Control-Allow-Origin *
		root * /opt/inufly/dist-remote
		file_server
	}
	handle {
		respond "InuFly fly server" 200
	}
}
